# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Tiger Data / Tiger Cloud (TimescaleDB). sslmode=require.
TIGER_DSN=postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require

# Gemini. Claim via mlh.link/gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Narration (the "Narrate" button) uses the browser's own Web Speech API —
# no key, no account, nothing to configure here.

# Expose the runtime scripted-demo toggle (off by default). Restart Flask after changing.
TORSADE_DEMO_ENABLED=0
